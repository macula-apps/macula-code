{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "env": {
    "node": true,
    "es2022": true
  },
  "rules": {
    "max-depth": ["error", 3],
    "complexity": ["error", 9]
  },
  "ignorePatterns": ["dist/", "node_modules/", "out/"]
}
